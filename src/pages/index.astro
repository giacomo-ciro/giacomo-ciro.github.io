---
import { Image } from 'astro:assets';
import Default from '../layouts/Default.astro';
import ProjectRow from '../components/ProjectRow.astro';
import profilePic from '../assets/profile-pic.png';
import AboutMe from '../components/AboutMe.md';
import projects from '../data/projects.yml';
import timeline from '../data/timeline.yml';
import { renderMarkdown } from '../markdown.mjs';
import sitePackage from '../../package.json';

const abbreviateMonth = (date: string) => date.replace(/^(\w{3})\w*/, '$1');

const previewTimeline = await Promise.all(
  timeline
    .filter((e) => e.strong === true)
    .slice(0, 3)
    .map(async (e) => ({
      ...e,
      date: abbreviateMonth(e.date),
      html: await renderMarkdown(e.description),
    }))
);
const previewProjects = projects.slice(0, 3);
---
<Default title="MSc in Artificial Intelligence">
<section id="hero" class="hero page-col">
    <div class="hero-text">
      {sitePackage.showProfileImage && (
        <div class="img-container">
          <Image src={profilePic} alt="Giacomo Cirò" width={409} height={409} loading="eager" />
        </div>
      )}
      <h1 class="hero-name">Giacomo Cirò</h1>
      <ul>
        <li>CS Student</li>
        <li>ML Researcher</li>
        <li>TH 16</li>
      </ul>
    </div>
</section>
<section class="d-flex flex-column justify-content-center page-col">
<AboutMe />
</section>

<section class="d-flex flex-column justify-content-center page-col" id="timeline-preview-section">
  <h1>Timeline</h1>
  <div id="timeline-preview" class="d-flex flex-column">
    {previewTimeline.map((event) => (
      <div class="timeline-event strong d-flex flex-row align-items-center">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-date">{event.date}</div>
          <div class="timeline-title" set:html={event.html} />
        </div>
      </div>
    ))}
  </div>
  <div class="view-more-wrap">
    <a class="view-more-btn" href="/timeline/">full timeline <span class="arrow">&rarr;</span></a>
  </div>
</section>

<section class="d-flex flex-column justify-content-center page-col" id="projects-preview-section">
  <h1>Projects</h1>
  <div id="project-preview-row" class="project-list">
    {previewProjects.map((project) => (
      <ProjectRow project={project} />
    ))}
  </div>
  <div class="view-more-wrap">
    <a class="view-more-btn" href="/projects/">all projects <span class="arrow">&rarr;</span></a>
  </div>
</section>
</Default>
