---
const path = Astro.url.pathname;
---
<header class="site-header page-col">
  <nav aria-label="Main navigation">
    <a href="/" class={path === '/' ? 'active' : undefined}>home</a>
    <a href="/projects/" class={path.includes('/projects') ? 'active' : undefined}>projects</a>
    <a href="/timeline/" class={path.includes('/timeline') ? 'active' : undefined}>timeline</a>
    <a href="/resources/" class={path.includes('/resources') ? 'active' : undefined}>resources</a>
    <a href="/quotes/" class={path.includes('/quotes') ? 'active' : undefined}>quotes</a>
    <a href="/assets/docs/Giacomo_Ciro_CV.pdf" target="_blank" aria-label="CV">cv</a>
  </nav>
</header>
